# FA Full-Time Fixture URLs (comma-separated)
# Get these from the FA Full-Time website by navigating to your team's fixtures page
# Example: https://fulltime.thefa.com/fixtures.html?selectedSeason=...&selectedTeam=...
FIXTURE_URLS=https://fulltime.thefa.com/fixtures.html?selectedSeason=XXX&selectedTeam=YYY

# Google Calendar ID
# Found in Google Calendar settings under "Integrate calendar"
# Format: something@group.calendar.google.com or your email for primary calendar
CALENDAR_ID=your_calendar_id@group.calendar.google.com

# Time to run daily fixture poll (24-hour format, default: 08:00)
POLL_SCHEDULE=08:00

# Timezone for calendar events (default: Europe/London)
TZ=Europe/London

# Team name translations for shorter calendar event titles
# Format: Full Team Name:Short Name,Another Team:Nickname
# Example: Boldmere St Michaels Juniors U11 2015 JH:Mikes,Castle Vale FC U12:CV
TEAM_NAMES=
