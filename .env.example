# FA Full-Time Fixture URLs (comma-separated)
# Get these from the FA Full-Time website by navigating to your team's fixtures page
# Example: https://fulltime.thefa.com/fixtures.html?selectedSeason=...&selectedTeam=...
# For multiple teams, separate with commas (no spaces)
FIXTURE_URLS=https://fulltime.thefa.com/fixtures.html?team1,https://fulltime.thefa.com/fixtures.html?team2

# Google Calendar IDs (comma-separated, one per fixture URL in the same order)
# Found in Google Calendar settings under "Integrate calendar"
# Each team can have their own calendar - create separate calendars and list IDs here
# Format: cal_id_for_team1,cal_id_for_team2
CALENDAR_IDS=team1_calendar@group.calendar.google.com,team2_calendar@group.calendar.google.com

# How often to poll for fixture updates, in hours (default: 12)
# Examples: 1 = every hour, 6 = every 6 hours, 24 = once daily
POLL_INTERVAL_HOURS=12

# Timezone for calendar events (default: Europe/London)
TZ=Europe/London

# Team name translations for shorter calendar event titles
# Format: Full Team Name:Short Name,Another Team:Nickname
TEAM_NAMES=West Bromwoch Albion:WBA,England:ENG

# Kit colours for Spond match events (optional)
# Format: Full FA Team Name:home:away,Another Team:home:away
# Use colour names (unquoted) or hex. Unquoted # starts a comment in .env — quote hex values:
#   TEAM_COLOURS=Example FC U12:white:purple
#   TEAM_COLOURS="Example FC U12:#ffffff:#8000ff"
# Bare hex without # also works: Example FC U12:ffffff:8000ff
# Only our kit is sent (opponentColour is omitted).
TEAM_COLOURS=Example FC U12:white:purple

# Email notifications (optional - leave blank to disable)
# For Gmail: use your email as SMTP_USER and an App Password as SMTP_PASSWORD
# To create an App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Multiple recipients supported - separate with commas (no spaces)
EMAIL_TO=recipient1@example.com,recipient2@example.com

# Spond integration (optional - leave blank to disable)
# Creates events in Spond when new fixtures are found
SPOND_EMAIL=your.email@example.com
SPOND_PASSWORD=your-spond-password
# Spond Group IDs (comma-separated, one per fixture URL in the same order)
# To find your Group ID: Open Spond web app, go to your group, copy ID from URL
# Example URL: https://spond.com/landing/group/ABCD1234 -> Group ID is ABCD1234
SPOND_GROUP_IDS=group_id_for_team1,group_id_for_team2
# Spond Host IDs (optional, comma-separated, one per fixture URL)
# The member ID of who should be the event host (e.g., team manager)
# Leave blank to use your own account as host
# To find a member ID: Inspect network requests in Spond web app when viewing group members
SPOND_HOST_IDS=host_member_id_for_team1,host_member_id_for_team2

# Google Maps API key for Spond map pins (optional but recommended)
# Enable both: Geocoding API and Places API
# Places is what matches the Google Maps app pin for named grounds (stadiums, schools)
# Get a key: https://console.cloud.google.com/google/maps-apis/credentials
# Restrict the key to Geocoding + Places if you can
# Without this, locations fall back to a UK postcode centroid
GOOGLE_MAPS_API_KEY=

# Dry run mode - test without creating events (true/false)
# Useful for testing geocoding and address lookup
DRY_RUN=true
