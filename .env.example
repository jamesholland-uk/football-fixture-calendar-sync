# FA Full-Time Fixture URLs (comma-separated)
# Get these from the FA Full-Time website by navigating to your team's fixtures page
# Example: https://fulltime.thefa.com/fixtures.html?selectedSeason=...&selectedTeam=...
# For multiple sons, separate with commas (no spaces)
FIXTURE_URLS=https://fulltime.thefa.com/fixtures.html?son1,https://fulltime.thefa.com/fixtures.html?son2

# Google Calendar IDs (comma-separated, one per fixture URL in the same order)
# Found in Google Calendar settings under "Integrate calendar"
# Each son can have their own calendar - create separate calendars and list IDs here
# Format: cal_id_for_son1,cal_id_for_son2
CALENDAR_IDS=son1_calendar@group.calendar.google.com,son2_calendar@group.calendar.google.com

# How often to poll for fixture updates, in hours (default: 12)
# Examples: 1 = every hour, 6 = every 6 hours, 24 = once daily
POLL_INTERVAL_HOURS=12

# Timezone for calendar events (default: Europe/London)
TZ=Europe/London

# Team name translations for shorter calendar event titles
# Format: Full Team Name:Short Name,Another Team:Nickname
TEAM_NAMES=West Bromwoch Albion:WBA,England:ENG

# Email notifications (optional - leave blank to disable)
# For Gmail: use your email as SMTP_USER and an App Password as SMTP_PASSWORD
# To create an App Password: Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=recipient@example.com
